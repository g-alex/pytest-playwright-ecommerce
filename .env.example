# Local or staging Mini App stand (no trailing slash). Never production.
BASE_URL=http://localhost:3000

# Must be web_tg_<username> so browser checkout form regenerates the same id
TEST_USER_ID=web_tg_aqa_local_user

# Default request timeout in seconds
REQUEST_TIMEOUT=15

# Browser / headed mode: use pytest-playwright CLI
#   python -m pytest -m ui --browser chromium
#   python -m pytest -m ui --headed --slowmo 300
